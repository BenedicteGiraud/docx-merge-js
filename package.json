{
  "name": "@benedicte/docx-merge",
  "version": "1.0.0",
  "description": "A fast Node.js library written in TypeScript for merging two Microsoft Word (.docx) documents into one.",
  "bugs": {
    "url": "https://github.com/BenedicteGiraud/docx-merge-js/issues"
  },
  "homepage": "https://github.com/BenedicteGiraud/docx-merge-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenedicteGiraud/docx-merge-js.git"
  },
  "type": "module",
  "main": "index.cjs",
  "exports": {
    "import": "./index.cjs",
    "require": "./index.cjs"
  },
  "types": "index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.ts*\" ",
    "format:check": "prettier --check \"src/**/*.ts*\"",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "docx",
    "merge",
    "typescript",
    "nodejs",
    "library",
    "fast",
    "microsoft word",
    "document",
    "office",
    "xml",
    "zip"
  ],
  "author": "Benedicte Giraud",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitest/ui": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fast-xml-parser": "^5.3.2"
  }
}